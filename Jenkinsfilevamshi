pipeline {
    agent any

    environment {
        SONARQUBE_SERVER = 'SonarQube' // Name of the SonarQube instance configured in Jenkins
        SONAR_TOKEN = credentials('https://github.com/Vamshi420/myweb.git') // Use the secret ID you set in Jenkins credentials
    }

    tools {
        maven 'Maven 3.9.9' // Your configured Maven version name in Jenkins
    }

    stages {
        stage('Git Checkout') {
            steps {
                git url: 'https://github.com/Vamshi420/myweb.git', branch: 'master'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh "mvn sonar:sonar -Dsonar.projectKey=myweb -Dsonar.token=${squ_724a3324f13aecb3fb084720e2e81a136b33c202}"
                }
            }
        }
    }
}
